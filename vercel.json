{
  "redirects": [
    {
      "source": "/inner_pages/about",
      "destination": "/apropos.html",
      "permanent": true
    },
    {
      "source": "/inner_pages/contact",
      "destination": "/contact.html",
      "permanent": true
    },
    {
      "source": "/inner_pages/:path*",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}